# DigiLocker Backend API URL
REACT_APP_API_URL=https://zella-screenings-backend.onrender.com

# Frontend URL (for redirects)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Google Maps JavaScript API key for the optional address pin map in case
# creation. This key is inlined into the browser bundle at build time and is
# therefore PUBLIC -- restrict it by HTTP referrer to the admin-panel domain in
# the Google Cloud console, and do NOT reuse the backend's GOOGLE_MAPS_API_KEY.
# Without it, address search still works; only the map degrades to a notice.
REACT_APP_GOOGLE_MAPS_API_KEY=
